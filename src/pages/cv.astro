---
// Printable CV built from the same data as the site; scripts/build-cv-pdf.mjs renders it to PDF.
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { profile } from '../data/profile';
import { education, jobs } from '../data/experience';
import { credentials } from '../data/learning';
import { skills } from '../data/skills';
import { formatMonth } from '../lib/dates';

const site = Astro.site!.href.replace(/^https?:\/\//, '').replace(/\/$/, '');
const linkedin = profile.contact.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const range = (start: string, end?: string) => `${formatMonth(start)} – ${formatMonth(end)}`;
---

<BaseLayout title={`${profile.name} CV`} description={profile.cv.summary} noindex>
  <nav class="toolbar" aria-label="CV actions">
    <a href="/">← Back to site</a>
    <a class="download" href={profile.cvUrl} download={profile.cvFileName}>
      Download PDF <span aria-hidden="true">↓</span>
    </a>
  </nav>

  <main id="main" class="sheet">
    <header class="top">
      <div>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
      </div>
      <Logo size={40} class="logo" />
    </header>
    <ul class="contact">
      <li>{profile.location}</li>
      <li><a href={`tel:${profile.cv.phone.replace(/\s/g, '')}`}>{profile.cv.phone}</a></li>
      <li><a href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a></li>
      <li><a href={Astro.site!.href}>{site}</a></li>
      <li><a href={profile.contact.linkedin}>{linkedin}</a></li>
    </ul>

    <section>
      <h2>Profile</h2>
      <p class="summary">{profile.cv.summary}</p>
    </section>

    <section>
      <h2>Skills</h2>
      <dl class="skills">
        {
          skills.map((s) => (
            <div>
              <dt>{s.group}</dt>
              <dd>{s.items.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section>
      <h2>Experience</h2>
      {
        jobs.map((j) => (
          <article class="job">
            <header class="job-head">
              <h3>
                {j.title} <span class="org">· {j.org}</span>
                {j.location && <span class="loc">, {j.location}</span>}
              </h3>
              <p class="dates">{range(j.start, j.end)}</p>
            </header>
            <p class="job-summary">{j.summary}</p>
            {j.highlights && (
              <ul class="bullets">
                {j.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
            {j.projects && (
              <ul class="projects">
                {j.projects.map((p) => (
                  <li>
                    <strong>{p.name}</strong> — {p.summary} <span class="tech">{p.tech.join(' · ')}</span>
                  </li>
                ))}
              </ul>
            )}
            {j.tech && <p class="tech">{j.tech.join(' · ')}</p>}
          </article>
        ))
      }
    </section>

    <div class="cols">
      <section>
        <h2>Certifications</h2>
        <ul class="certs">
          {
            credentials.map((c) => (
              <li>
                <strong>{c.name}</strong>
                <span>
                  {c.provider} · {formatMonth(c.date)}
                </span>
              </li>
            ))
          }
        </ul>
      </section>
      <div>
        <section>
          <h2>Education</h2>
          {
            education.map((e) => (
              <p class="edu">
                <strong>{e.degree}</strong>
                <span>{e.school}</span>
                <span>
                  {e.start} – {e.end}
                </span>
              </p>
            ))
          }
        </section>
        <section>
          <h2>Languages</h2>
          <p class="plain">{profile.languages.map((l) => `${l.name} (${l.level.toLowerCase()})`).join(' · ')}</p>
        </section>
        <section>
          <h2>Interests</h2>
          <p class="plain">{profile.cv.interests}</p>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  :global(body) {
    background: #eeeeec;
  }
  .toolbar {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px var(--gutter);
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
  }
  .toolbar a {
    text-decoration: none;
    padding: 6px 0;
  }
  .toolbar .download {
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--on-ink);
    font-weight: 600;
  }

  /* The sheet mirrors an A4 page on screen. */
  .sheet {
    width: min(210mm, 100% - 32px);
    margin: 32px auto 64px;
    padding: 16mm 15mm;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.08), 0 12px 40px -12px rgb(0 0 0 / 0.15);
    font-size: 9.5pt;
    line-height: 1.4;
    color: #1a1a1a;
  }
  .sheet a {
    text-decoration: none;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }
  h1 {
    font-size: 26pt;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .role {
    margin-top: 5pt;
    font-size: 12pt;
    font-weight: 500;
  }
  .logo {
    flex-shrink: 0;
    color: var(--ink);
  }
  .contact {
    font-size: 8.8pt;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 2pt 0;
    padding: 0;
    margin: 10pt 0 0;
    color: #444;
  }
  @media screen {
    .contact a {
      display: inline-block;
      padding: 4px 0;
    }
  }
  .contact li + li::before {
    content: '·';
    margin: 0 7pt;
    color: #999;
  }

  section {
    margin-top: 12pt;
  }
  h2 {
    display: flex;
    align-items: center;
    gap: 8pt;
    margin-bottom: 7pt;
    font-family: var(--font-mono);
    font-size: 8pt;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h2::after {
    content: '';
    flex: 1;
    border-top: 1px solid var(--ink);
  }

  .summary {
    font-size: 10pt;
  }

  .skills {
    display: grid;
    gap: 2pt;
    margin: 0;
  }
  .skills div {
    display: grid;
    grid-template-columns: 30mm 1fr;
    gap: 8pt;
  }
  dt {
    font-weight: 600;
  }
  dd {
    margin: 0;
    color: #333;
  }

  .job {
    margin-top: 9pt;
  }
  .job-head {
    break-after: avoid;
  }
  .projects li,
  .bullets li {
    break-inside: avoid;
  }
  .job:first-of-type {
    margin-top: 0;
  }
  .job-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12pt;
  }
  h3 {
    font-size: 10.5pt;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .org {
    font-weight: 600;
  }
  .loc {
    font-weight: 400;
    color: #555;
  }
  .dates {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 8pt;
    color: #444;
  }
  .job-summary {
    margin-top: 2pt;
  }
  .bullets,
  .projects {
    margin: 3pt 0 0;
    padding-left: 12pt;
  }
  .bullets li,
  .projects li {
    margin-top: 1.5pt;
  }
  .projects li::marker {
    content: '▸  ';
    font-size: 7pt;
  }
  .tech {
    color: #666;
    font-size: 8.5pt;
  }
  p.tech {
    margin-top: 2pt;
  }

  .cols {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 0 18pt;
    break-inside: avoid-page;
  }
  .certs {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .certs li,
  .edu {
    display: flex;
    flex-direction: column;
    margin-bottom: 4pt;
  }
  .certs span,
  .edu span {
    color: #555;
    font-size: 8.5pt;
  }

  @page {
    size: A4;
    margin: 14mm 15mm;
  }
  @media print {
    :global(body) {
      background: #fff;
    }
    :global(.skip-link),
    .toolbar {
      display: none;
    }
    .sheet {
      width: auto;
      margin: 0;
      padding: 0;
      box-shadow: none;
    }
    h2 {
      break-after: avoid;
    }
  }
  @media (max-width: 640px) {
    .sheet {
      padding: 20px 16px;
    }
    .skills,
    .cols {
      grid-template-columns: 1fr;
    }
    .skills div {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .job-head {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
