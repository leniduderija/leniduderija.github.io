---
import { profile } from '../data/profile';
import { jobs } from '../data/experience';
import { monthsBetween } from '../lib/dates';

const years = Math.floor(monthsBetween(profile.careerStart) / 12);
const projectCount = jobs.reduce((n, j) => n + (j.projects?.length ?? 0), 0);
const stats = [
  { value: `${years}+`, label: 'Years building for the web' },
  { value: String(jobs.length), label: 'Companies' },
  { value: String(projectCount), label: 'Client projects' },
  { value: 'React', label: 'Ecosystem of choice' },
];
---

<section class="hero">
  <div class="container">
    <p class="eyebrow">{profile.role} — {profile.location}</p>
    <h1>{profile.name}</h1>
    <div class="row">
      <p class="headline">{profile.headline}</p>
      <div class="actions">
        <a class="button" href={profile.cvUrl} download>Download CV<span class="sr-only"> (PDF)</span> <span aria-hidden="true">↓</span></a>
        <a class="button outline" href="#contact">Get in touch</a>
      </div>
    </div>
    <dl class="stats">
      {
        stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    padding: clamp(72px, 12vw, 160px) 0 clamp(48px, 6vw, 80px);
  }
  h1 {
    font-size: clamp(3rem, 11vw, 10rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.92;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-top: clamp(32px, 4vw, 56px);
  }
  .headline {
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
    max-width: 30ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: clamp(56px, 8vw, 112px) 0 0;
    border-top: 1px solid var(--ink);
  }
  .stats > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
    padding: 20px 20px 0 0;
  }
  .stats > div + div {
    padding-left: 20px;
    border-left: 1px solid var(--border);
  }
  dd {
    margin: 0;
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  dt {
    font-size: 0.85rem;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .stats > div + div:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .stats > div:nth-child(n + 3) {
      padding-top: 24px;
    }
  }
</style>
