---
import { profile } from '../data/profile';
---

<footer>
  <div class="container inner">
    <span>© {new Date().getFullYear()} {profile.name}</span>
    <span>{profile.location}</span>
  </div>
</footer>

<style>
  footer {
    background: var(--ink);
    color: #8a8a8a;
    border-top: 1px solid #222;
    font-size: 0.85rem;
  }
  .inner {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 28px;
    padding-bottom: 28px;
  }
</style>
