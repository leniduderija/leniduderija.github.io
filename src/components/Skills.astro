---
import { skills } from '../data/skills';
---

<section id="skills" class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">04 — Skills</p>
        <h2 class="section-title">Technologies</h2>
      </div>
    </div>
    <div class="grid">
      {
        skills.map((s, i) => (
          <div class="group">
            <p class="index">{String(i + 1).padStart(2, '0')}</p>
            <h3>{s.group}</h3>
            <ul class="chips">
              {s.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 0 32px;
  }
  .group {
    padding: 20px 0 36px;
    border-top: 1px solid var(--ink);
  }
  .index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  h3 {
    font-size: 1.2rem;
    margin: 8px 0 18px;
  }
</style>
